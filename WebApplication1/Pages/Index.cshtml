@page
@model IndexModel
@{
    ViewData["Title"] = "БОБРО ЖАЛОВАТЬ";
}

<h1>Список пользователей из PostgreSQL</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Created At</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Users)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.CreatedAt</td>
            </tr>
        }
    </tbody>
</table>