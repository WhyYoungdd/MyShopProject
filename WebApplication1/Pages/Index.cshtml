@page
@model IndexModel
@{
    ViewData["Title"] = "Магазин";
}

<style>
    /* Стили для интерактивных карточек */
    .product-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        position: relative;
        background-color: #f8f9fa; /* Светло-серый фон как у Figma */
        border: none;
    }

        .product-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .product-img-container {
        background-color: #fff;
        position: relative;
        overflow: hidden;
    }

    .product-img {
        transition: transform 0.5s ease;
        object-fit: contain;
        padding: 20px;
    }

    .product-card:hover .product-img {
        transform: scale(1.05); /* Легкое увеличение картинки */
    }

    /* Панель размеров (скрыта по умолчанию) */
    .size-overlay {
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        background-color: rgba(255, 255, 255, 0.95);
        padding: 15px;
        opacity: 0;
        transform: translateY(100%);
        transition: all 0.3s ease;
        border-top: 1px solid #eee;
    }

    .product-card:hover .size-overlay {
        opacity: 1;
        transform: translateY(0); /* Выезжает снизу при наведении */
    }

    .size-btn {
        border: 1px solid #ccc;
        background: #fff;
        padding: 4px 10px;
        font-size: 14px;
        margin: 0 2px;
        cursor: pointer;
        transition: all 0.2s;
    }

        .size-btn:hover, .size-btn.selected {
            background: #000;
            color: #fff;
            border-color: #000;
        }

    /* Черная полоса с размерами как на скрине Figma */
    .figma-sizes-bar {
        background-color: #000;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 5px 10px;
        margin-top: 10px;
    }

        .figma-sizes-bar .size-circle {
            color: #000;
            background: #fff;
            border-radius: 50%;
            width: 30px;
            height: 30px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 14px;
        }

        .figma-sizes-bar .sizes-list {
            display: flex;
            gap: 2px;
            color: #fff;
        }

            .figma-sizes-bar .sizes-list span {
                border: 1px solid #fff;
                padding: 2px 8px;
                font-size: 14px;
                cursor: pointer;
            }

                .figma-sizes-bar .sizes-list span:hover {
                    background: #fff;
                    color: #000;
                }

    .add-to-cart-bar {
        background-color: #00ff00; /* Ярко-зеленый как у Figma */
        color: #000;
        text-align: center;
        padding: 12px;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.2s;
    }

        .add-to-cart-bar:hover {
            background-color: #00cc00;
        }
</style>

<div class="container mt-5">
    <!-- Заголовок как на Figma -->
    <div class="text-center mb-5">
        <h1 class="display-3 fw-light" style="font-family: serif;">Сезон 5</h1>
