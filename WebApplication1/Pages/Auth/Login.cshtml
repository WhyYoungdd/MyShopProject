@page
@model WebApplication1.Pages.Auth.LoginModel
@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Вход в систему</h2>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @Model.ErrorMessage
                        </div>
                    }

                    <form method="post">
                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" class="form-control" type="email" placeholder="name@example.com" required />
                        </div>
                        <div class="mb-4">
                            <label asp-for="Password" class="form-label">Пароль</label>
                            <input asp-for="Password" class="form-control" type="password" placeholder="••••••" required />
                        </div>
                        <button type="submit" class="btn btn-success w-100 py-2">Войти</button>
                    </form>
                </div>
            </div>
            <div class="text-center mt-3">
                <span class="text-muted">Нет аккаунта?</span> <a asp-page="/Auth/Register" class="text-decoration-none">Зарегистрироваться</a>
            </div>
        </div>
    </div>
</div>