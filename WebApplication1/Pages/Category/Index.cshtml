@page
@model WebApplication1.Pages.Category.IndexModel
@{
    ViewData["Title"] = "Категории";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h3 mb-0">Категории</h1>
        <span class="badge bg-secondary">@Model.Categories.Count</span>
    </div>

    <p>
        <a asp-page="/Category/Create" class="btn btn-primary">Добавить категорию</a>
    </p>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col" style="width: 80px;">Id</th>
                        <th scope="col">Название</th>
                        <th scope="col" style="width: 220px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var category in Model.Categories)
                    {
                        <tr>
                            <td class="text-muted">@category.Id</td>
                            <td>@category.Name</td>
                            <td>
                                <a asp-page="/Category/Edit" asp-route-id="@category.Id" class="btn btn-warning btn-sm">Редактировать</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@category.Id" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (!Model.Categories.Any())
    {
        <div class="alert alert-info mt-3">Категорий пока нет. Добавьте первую!</div>
    }
</div>